{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homeward.local/contracts/flag.schema.json",
  "title": "Flag",
  "description": "One risk flag produced by the deterministic rules engine (api/rules.py) from a CallResult + LiveVitals + Patient. Flags are for nurse review, not diagnoses. All thresholds are demo placeholders.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "patient_id", "call_id", "code", "tier", "reason", "rule_id", "created_at", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^flg_[a-z0-9]{4,40}$"},
    "patient_id": {"type": "string"},
    "call_id": {"type": ["string", "null"]},
    "code": {"enum": [
      "emergency_script_given",
      "care_team_symptom",
      "symptom_worse_than_last_call",
      "missed_dose_possible",
      "pill_check_unknown",
      "hr_high_at_rest",
      "rhr_drift",
      "breathing_outside_wellness_range",
      "vitals_stale",
      "no_answer",
      "call_incomplete",
      "agent_concern"
    ]},
    "tier": {"enum": ["GREEN", "YELLOW", "RED"]},
    "reason": {"type": "string", "maxLength": 240, "description": "Human-readable, e.g. 'Reported more short of breath than yesterday (confirmed)'."},
    "evidence": {"type": "object", "description": "Free-form pointers: quotes, numbers, proof_ref."},
    "rule_id": {"type": "string", "description": "Key in api/rules.yaml."},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["open", "acknowledged", "resolved"]}
  }
}
